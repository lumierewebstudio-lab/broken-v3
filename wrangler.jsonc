{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "broken-v3",

  "main": "src/worker.js",

  "compatibility_date": "2026-10-04",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  }
}
